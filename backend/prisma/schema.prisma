generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "sqlite"
}

model Department {
  id          Int    @id @default(autoincrement())
  name        String @unique
  description String @default("")
  createdAt   String @default(dbgenerated("CURRENT_TIMESTAMP")) @map("created_at")
  users       User[]

  @@map("departments")
}

model Role {
  id              Int              @id @default(autoincrement())
  name            String           @unique
  description     String           @default("")
  isSystem        Boolean          @default(false) @map("is_system")
  createdAt       String           @default(dbgenerated("CURRENT_TIMESTAMP")) @map("created_at")
  updatedAt       String           @default(dbgenerated("CURRENT_TIMESTAMP")) @map("updated_at")
  users           User[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id              Int              @id @default(autoincrement())
  code            String           @unique
  module          String
  moduleLabel     String           @map("module_label")
  action          String
  actionLabel     String           @map("action_label")
  rolePermissions RolePermission[]

  @@unique([module, action])
  @@map("permissions")
}

model RolePermission {
  roleId       Int        @map("role_id")
  permissionId Int        @map("permission_id")
  createdAt    String     @default(dbgenerated("CURRENT_TIMESTAMP")) @map("created_at")
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model User {
  id           Int           @id @default(autoincrement())
  employeeNo   String        @unique @map("employee_no")
  name         String
  email        String?       @unique
  phone        String?
  passwordHash String        @map("password_hash")
  roleId       Int           @map("role_id")
  departmentId Int           @map("department_id")
  status       String        @default("active")
  lastLoginAt  String?       @map("last_login_at")
  createdAt    String        @default(dbgenerated("CURRENT_TIMESTAMP")) @map("created_at")
  updatedAt    String        @default(dbgenerated("CURRENT_TIMESTAMP")) @map("updated_at")
  role         Role          @relation(fields: [roleId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  department   Department    @relation(fields: [departmentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  sessions     Session[]
  auditLogs    AuditLog[]
  inboxItems   InboxItem[]
  repairOrders      RepairOrder[]      @relation("RepairOrderManager")
  damageAnnotations DamageAnnotation[]

  @@index([roleId])
  @@index([departmentId])
  @@map("users")
}

model Session {
  id        Int     @id @default(autoincrement())
  userId    Int     @map("user_id")
  tokenHash String  @unique @map("token_hash")
  ip        String?
  userAgent String? @map("user_agent")
  expiresAt String  @map("expires_at")
  createdAt String  @default(dbgenerated("CURRENT_TIMESTAMP")) @map("created_at")
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([tokenHash])
  @@map("sessions")
}

model AuditLog {
  id          Int     @id @default(autoincrement())
  actorUserId Int?    @map("actor_user_id")
  action      String
  targetType  String  @map("target_type")
  targetId    String? @map("target_id")
  summary     String
  ip          String?
  createdAt   String  @default(dbgenerated("CURRENT_TIMESTAMP")) @map("created_at")
  actor       User?   @relation(fields: [actorUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([createdAt])
  @@map("audit_logs")
}

model InboxItem {
  id        Int     @id @default(autoincrement())
  userId    Int     @map("user_id")
  kind      String
  title     String
  body      String
  href      String  @default("")
  tone      String  @default("info")
  sender    String?
  isRead    Boolean @default(false) @map("is_read")
  createdAt String  @default(dbgenerated("CURRENT_TIMESTAMP")) @map("created_at")
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId, kind, isRead, createdAt])
  @@map("inbox_items")
}

model Station {
  id          Int       @id @default(autoincrement())
  code        String    @unique
  name        String
  city        String
  district    String
  address     String
  latitude    Float?
  longitude   Float?
  stationType String    @default("station") @map("station_type")
  status      String    @default("active")
  createdAt   String    @default(dbgenerated("CURRENT_TIMESTAMP")) @map("created_at")
  updatedAt   String    @default(dbgenerated("CURRENT_TIMESTAMP")) @map("updated_at")
  vehicles    Vehicle[]

  @@index([city, district, status])
  @@map("stations")
}

model Vehicle {
  id             Int                    @id @default(autoincrement())
  licensePlate   String                 @unique @map("license_plate")
  model          String
  color          String
  stationId      Int                    @map("station_id")
  status         String                 @default("available")
  cabinCondition String                 @default("clean") @map("cabin_condition")
  todayMileage   Float                  @default(0) @map("today_mileage")
  latestAnomaly  String?                @map("latest_anomaly")
  createdAt      String                 @default(dbgenerated("CURRENT_TIMESTAMP")) @map("created_at")
  updatedAt      String                 @default(dbgenerated("CURRENT_TIMESTAMP")) @map("updated_at")
  station        Station                @relation(fields: [stationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  anomalyAlerts  AiAnomalyAlert[]
  rentals        Rental[]
  serviceRecords VehicleServiceRecord[]
  repairOrders   RepairOrder[]
  cleaningOrders CleaningOrder[]

  @@index([stationId, status])
  @@map("vehicles")
}

model Rental {
  id         Int       @id @default(autoincrement())
  vehicleId  Int       @map("vehicle_id")
  customerId Int?      @map("customer_id")
  startedAt  String    @map("started_at")
  endedAt    String?   @map("ended_at")
  status     String    @default("completed")
  rentalFee  Int       @default(0) @map("rental_fee")
  createdAt  String    @default(dbgenerated("CURRENT_TIMESTAMP")) @map("created_at")
  updatedAt  String    @default(dbgenerated("CURRENT_TIMESTAMP")) @map("updated_at")
  vehicle    Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@unique([vehicleId, startedAt, endedAt])
  @@index([customerId])
  @@index([startedAt, endedAt, status])
  @@map("rentals")
}

model Customer {
  id        Int      @id @default(autoincrement())
  memberNo  String   @unique @map("member_no")
  fullName  String   @map("full_name")
  phone     String
  createdAt String   @default(dbgenerated("CURRENT_TIMESTAMP")) @map("created_at")
  updatedAt String   @default(dbgenerated("CURRENT_TIMESTAMP")) @map("updated_at")
  rentals   Rental[]

  @@map("customers")
}

model VehicleServiceRecord {
  id          Int     @id @default(autoincrement())
  vehicleId   Int     @map("vehicle_id")
  type        String
  performedAt String  @map("performed_at")
  cost        Int     @default(0)
  note        String  @default("")
  createdAt   String  @default(dbgenerated("CURRENT_TIMESTAMP")) @map("created_at")
  updatedAt   String  @default(dbgenerated("CURRENT_TIMESTAMP")) @map("updated_at")
  vehicle     Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([vehicleId, type, performedAt])
  @@index([vehicleId, performedAt])
  @@map("vehicle_service_records")
}

model RepairOrder {
  id                  Int     @id @default(autoincrement())
  repairCenter        String  @map("repair_center")
  orderNumber         String  @unique @map("order_number")
  vehicleLicensePlate String  @map("vehicle_license_plate")
  maintenanceItem     String  @map("maintenance_item")
  status              String
  assignedManagerId   Int?    @map("assigned_manager_id")
  estimatedCost       Int     @default(0) @map("estimated_cost")
  actualCost          Int?    @map("actual_cost")
  createdAt           String  @default(dbgenerated("CURRENT_TIMESTAMP")) @map("created_at")
  completedAt         String? @map("completed_at")
  vehicle             Vehicle @relation(fields: [vehicleLicensePlate], references: [licensePlate], onDelete: Restrict, onUpdate: Cascade)
  assignedManager     User?   @relation("RepairOrderManager", fields: [assignedManagerId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([vehicleLicensePlate, status, createdAt])
  @@index([assignedManagerId, status])
  @@map("repair_orders")
}

model CleaningOrder {
  id                  Int     @id @default(autoincrement())
  orderNumber         String  @unique @map("order_number")
  vehicleLicensePlate String  @map("vehicle_license_plate")
  condition           String
  dispatchStatus      String   @default("unassigned") @map("dispatch_status")
  originalCondition   String  @default("dirty") @map("original_condition")
  cleaningFee         Int     @default(0) @map("cleaning_fee")
  cleaningProvider    String  @default("irent_staff") @map("cleaning_provider")
  note                String  @default("")
  createdAt           String  @default(dbgenerated("CURRENT_TIMESTAMP")) @map("created_at")
  updatedAt           String  @default(dbgenerated("CURRENT_TIMESTAMP")) @map("updated_at")
  vehicle             Vehicle @relation(fields: [vehicleLicensePlate], references: [licensePlate], onDelete: Restrict, onUpdate: Cascade)

  @@index([vehicleLicensePlate, createdAt])
  @@index([condition, createdAt])
  @@index([dispatchStatus, createdAt])
  @@map("cleaning_orders")
}

model AiAnomalyAlert {
  id          Int     @id @default(autoincrement())
  vehicleId   Int     @map("vehicle_id")
  anomalyType String  @map("anomaly_type")
  confidence  Int
  status      String  @default("pending")
  detectedAt  String  @default(dbgenerated("CURRENT_TIMESTAMP")) @map("detected_at")
  createdAt   String  @default(dbgenerated("CURRENT_TIMESTAMP")) @map("created_at")
  updatedAt   String  @default(dbgenerated("CURRENT_TIMESTAMP")) @map("updated_at")
  vehicle     Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([vehicleId, status, detectedAt])
  @@map("ai_anomaly_alerts")
}

model DamageAnnotation {
  id              Int      @id @default(autoincrement())
  caseId          String   @map("case_id")
  plateNumber     String   @map("plate_number")
  imageSide       String   @map("image_side")
  category        String
  x               Float
  y               Float
  width           Float
  height          Float
  yoloCoordinates String   @map("yolo_coordinates")
  createdById     Int?     @map("created_by_id")
  createdAt       String   @default(dbgenerated("CURRENT_TIMESTAMP")) @map("created_at")
  updatedAt       String   @default(dbgenerated("CURRENT_TIMESTAMP")) @map("updated_at")
  createdBy       User?    @relation(fields: [createdById], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([caseId, imageSide])
  @@index([plateNumber, createdAt])
  @@map("damage_annotations")
}
